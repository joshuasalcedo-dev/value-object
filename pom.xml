<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Published as io.joshuasalcedo:value-object, with its sources and Javadoc:
           mvn install                  on this machine
           mvn deploy -Prelease         Maven Central (the release workflow does this; it needs the Central
                                        token in settings.xml server "central", and MAVEN_GPG_KEY /
                                        MAVEN_GPG_PASSPHRASE for signing)
         A release sets the version from the tag v1.2.3: mvn versions:set -DnewVersion=1.2.3 -->
    <groupId>io.joshuasalcedo</groupId>
    <artifactId>value-object</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>value-object</name>
    <description>Small, immutable, self-validating value objects for Java.</description>
    <url>https://github.com/joshuasalcedo-dev/value-object</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>joshuasalcedo-dev</id>
            <name>Joshua Salcedo</name>
            <url>https://github.com/joshuasalcedo-dev</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/joshuasalcedo-dev/value-object</url>
        <connection>scm:git:https://github.com/joshuasalcedo-dev/value-object.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/joshuasalcedo-dev/value-object.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <buildDir>${project.basedir}/target</buildDir>
    </properties>

    <dependencies>
        <!-- Nullness annotations (@NullMarked, @Nullable) used across the value objects. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- OCR in the JVM (Tesseract through JavaCPP: native libraries for Windows, Linux and macOS are in the
             jars; no install, no Docker). Optional: only io.joshuasalcedo.valueobject.extract needs it, so a project
             that wants OCR adds this dependency itself. Language data (eng.traineddata) is found through
             TESSDATA_PREFIX or the usual install folders, or given to Ocr.open. -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>tesseract-platform</artifactId>
            <version>5.5.0-1.5.11</version>
            <optional>true</optional>
        </dependency>
        <!-- PDFs: optional; only io.joshuasalcedo.valueobject.extract needs it -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
            <optional>true</optional>
        </dependency>
        <!-- Connectors, all optional: a project gets them from its own framework (Spring Boot, Quarkus, ...).
               io.joshuasalcedo.valueobject.jackson   (Jackson 2: com.fasterxml)   ValueObjectModule
               io.joshuasalcedo.valueobject.jackson3  (Jackson 3: tools.jackson)   ValueObjectModule
               io.joshuasalcedo.valueobject.jpa       Jakarta Persistence converters
               io.joshuasalcedo.valueobject.validation  Jakarta Validation constraints -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.23.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.3.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.2.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>9.2.0.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>6.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- overridable, so parallel builds can each use their own folder: mvn test -DbuildDir=target-x -->
        <directory>${buildDir}</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <!-- a stable module name for the module path (the library has no module-info: its connectors are optional) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.joshuasalcedo.valueobject</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <!-- every check on: broken references, bad HTML and missing comments fail the build -->
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                    <additionalOptions>
                        <additionalOption>-Xmaxwarns</additionalOption>
                        <additionalOption>10000</additionalOption>
                        <additionalOption>-Xmaxerrs</additionalOption>
                        <additionalOption>10000</additionalOption>
                    </additionalOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- the documentation site: mvn pretty-docs:generate (target/pretty-docs), mvn pretty-docs:serve -->
            <plugin>
                <groupId>io.joshuasalcedo.pretty</groupId>
                <artifactId>pretty-docs-maven-plugin</artifactId>
                <version>1.3.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Signing and Maven Central: only on a release (mvn deploy -Prelease). -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!-- Signs in-process from env MAVEN_GPG_KEY (ASCII-armoured) + MAVEN_GPG_PASSPHRASE;
                                 no gpg binary or keyring needed. -->
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
